PackageIdentifier: SkyLLC.md2html
PackageVersion: @VERSION@
Platform:
- Windows.Desktop
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
- RelativeFilePath: md2html-windows-x64\md2html.exe
  PortableCommandAlias: md2html
InstallModes:
- silent
- silentWithProgress
Installers:
- Architecture: x64
  InstallerUrl: https://github.com/githubrobbi/md2html/releases/download/@TAG@/md2html-windows-x64.zip
  InstallerSha256: @SHA256@
ManifestType: installer
ManifestVersion: 1.28.0
ReleaseDate: @RELEASE_DATE@
