{
  "terms": [
    {
      "id": "outline",
      "en": "outline",
      "what": "the list of chapters at the left of the page, made from its headings; it can be hidden"
    },
    {
      "id": "callout",
      "en": "callout",
      "what": "a boxed aside in the text: a note, a tip, something important, a warning or a caution"
    },
    {
      "id": "figure",
      "en": "figure",
      "what": "an image on a line of its own, with its caption, enlarged on a click"
    },
    {
      "id": "front_matter",
      "en": "front matter",
      "what": "the block of settings between two `---` lines at the top of a Markdown file"
    },
    {
      "id": "passage",
      "en": "passage",
      "what": "a part of the text a reader selected, which the page can link to"
    },
    {
      "id": "text_size",
      "en": "text size",
      "what": "the control that makes the page's text larger or smaller"
    },
    {
      "id": "translation",
      "en": "translation",
      "what": "a version of a page in another language, a Markdown file beside the original"
    }
  ],
